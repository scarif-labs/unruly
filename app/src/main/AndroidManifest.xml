<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13 uses READ_MEDIA_AUDIO instead of READ_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"  />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"  />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Lyrics lookup only. This engine is otherwise entirely offline, so the permission is
         here for one third-party API call and nothing else. The lookup is user-toggleable in
         Shellac settings; when off, no request is ever made. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bluetooth auto-connect functionality (Disabled until permission workflow can be made) -->
<!--    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />-->
<!--    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" android:minSdkVersion="31" />-->
<!--    <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>-->

    <!-- Work around ExoPlayer requiring network permissions we do not use -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <queries />

    <application
        android:name=".Shellac"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_descriptor"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/info_app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shellac.App"
        android:appCategory="audio"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="UnusedAttribute">

        <meta-data android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc"/>
        <meta-data
                android:name="androidx.car.app.TintableAttributionIcon"
                android:resource="@drawable/ic_shellac_24" />

        <!--
        SHELLAC HOST. Hosts the active skin and nothing else.
        Kept alongside .MainActivity for now so the original UI stays testable; .MainActivity
        is removed once a real skin exists (buildspec Phase 5).
        -->
        <activity
            android:name=".shellac.host.ShellacActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Shellac"
            android:launchMode="singleTask"
            android:roundIcon="@mipmap/ic_launcher"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Moved off .MainActivity: this is the entry point that declares us a
                     music player, so it must be the one the system opens. -->
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity>

        <!--
        SHELLAC SETTINGS - buildspec 3.7. Never composes a skin.

        NO LAUNCHER ENTRY, deliberately - and this reverses an earlier decision, so the
        reasoning matters.

        It used to have its own LAUNCHER entry so it stayed reachable when the active skin
        was unusable. But it shipped with the SAME icon as the host and a near-identical
        label, so the launcher showed two indistinguishable "Shellac" icons. Users opened the
        wrong one, landed on a settings screen that composes no skin, changed a theme and saw
        nothing happen, then pressed back and got dumped out of the app - because this
        Activity was its own task root. That is a guaranteed daily papercut traded against a
        rare recovery case.

        The recovery case is already covered without a launcher icon: SkinRegistry
        quarantines a skin that crashed while composing and rewrites the stored preference to
        the fallback (DebugSkinA), which itself exposes a settings link. So a crashing skin
        self-recovers to a skin that can reach this screen.

        Still exported, so `adb shell am start` can reach it if a skin ever renders an
        unusable-but-non-crashing UI - the one gap the fallback path does not close.

        launchMode is singleTop, NOT singleTask. The Activity decides what back does by
        asking isTaskRoot: true means it was launched standalone and back should go to the
        host, false means a skin opened it and back should return there. singleTask lets the
        system host this Activity in a task of its own, which would report isTaskRoot=true
        while the host was alive and below it - the exact case the check exists to tell
        apart. singleTop keeps it in the caller's task, so the signal stays truthful.
        -->
        <!--
        FIRST-RUN SETUP. Grants the music folders Shellac scans.

        No launcher entry and not exported: it is only ever reached from ShellacActivity's
        first-run gate or from the "Music folders" row in settings, both in-process.

        launchMode is the default (standard) on purpose. It is started from two different
        tasks - the host's, and settings' own when settings was launched standalone - and in
        both cases it should sit on top of whoever started it so that finish() returns there.
        -->
        <activity
            android:name=".shellac.host.OnboardingActivity"
            android:exported="false"
            android:label="Shellac setup"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".shellac.host.ShellacSettingsActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Shellac Settings"
            android:launchMode="singleTop" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTask"
            android:allowCrossUidActivitySwitchFromBelow="false"
            android:roundIcon="@mipmap/ic_launcher"
            android:windowSoftInputMode="adjustNothing">

            <!--
            NO LAUNCHER ENTRY. This is Shellac's original pre-Shellac UI, kept only so it stays
            testable and so the "Shuffle All" launcher shortcut (Shellac.kt) keeps working -
            ShellacActivity does not yet parse intent actions, so repointing that shortcut
            here would silently do nothing.

            Its MAIN/LAUNCHER/MUSIC_PLAYER filter moved to .ShellacActivity. Leaving it here
            put a THIRD icon in the launcher that opened an entirely different interface from
            the other two, with no skin and no route to Shellac settings.

            Reachable by explicit intent, which is all the shortcut needs.
            -->
            <intent-filter>
                <!--
                Signal that we can take audio of *any* format, file or content. This is important,
                as some apps use this to determine if Shellac is eligible to be a default music
                player.
                -->
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />

                <!-- Normal audio mime types + weird mime types -->
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/itunes" />
            </intent-filter>
        </activity>


        <!--
        Service handling music playback, system components, and state saving.
        -->
        <service
            android:name=".ShellacService"
            android:foregroundServiceType="mediaPlayback"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:roundIcon="@mipmap/ic_launcher"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <!--
        Expose Shellac's cover data to the android system
        -->
        <provider
            android:name=".image.CoverProvider"
            android:authorities="@string/pkg_authority_cover"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!--
        Work around apps that blindly query for ACTION_MEDIA_BUTTON working.
        See the class for more info.
        -->
        <receiver
            android:name=".playback.service.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Receiver for bluetooth headset events -->
<!--        <receiver-->
<!--            android:name=".playback.system.BluetoothConnectReceiver"-->
<!--            android:exported="true">-->
<!--            <intent-filter>-->
<!--                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />-->
<!--            </intent-filter>-->
<!--        </receiver>-->

        <!-- "Now Playing" widget. -->
        <receiver
            android:name=".widgets.WidgetProvider"
            android:exported="false"
            android:label="@string/lbl_playback">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Tasker 'start service' integration -->
        <activity
            android:name=".tasker.ActivityConfigStartAction"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/lbl_start_playback">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>
    </application>
</manifest>