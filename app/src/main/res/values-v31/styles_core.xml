<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Unruly.V31" parent="Theme.Unruly.V29">
        <!-- The loading screen: the kicked u on Unruly red, the wordmark set in Inter Black below.
             Same mark as the launcher icon (logo direction L2-D). -->
        <item name="android:windowSplashScreenBackground">#E3191B</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#E3191B</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/ic_splash_wordmark</item>
    </style>

    <!-- Use dynamic colors since that's assumed to be the setting used. -->
    <style name="Theme.Unruly.App" parent="Theme.Unruly.Base" />

    <style name="Theme.Unruly.Widget" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="colorPrimary">?android:attr/colorAccent</item>
        <item name="colorOnPrimary">?attr/colorSurface</item>

        <item name="colorSurface">@color/widget_surface</item>
        <item name="colorSurfaceInverse">@color/widget_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/widget_on_surface_inverse</item>

        <item name="colorControlNormal">?android:attr/colorControlNormal</item>
    </style>
</resources>