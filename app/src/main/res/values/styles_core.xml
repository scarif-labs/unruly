<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Master parent theme -->
    <style name="Theme.Shellac" parent="Theme.Material3Expressive.DynamicColors.DayNight" />
    <!-- Adds nicer selector attributes not supported on lollipop -->
    <style name="Theme.Shellac.V23" parent="Theme.Shellac" />
    <!-- Handles edge-to-edge on other styles variants -->
    <style name="Theme.Shellac.V27" parent="Theme.Shellac.V23">
        <item name="android:statusBarColor">@color/chrome_translucent</item>
        <item name="android:navigationBarColor">@color/chrome_translucent</item>
    </style>
    <!-- Adds fully transparent system bars -->
    <style name="Theme.Shellac.V29" parent="Theme.Shellac.V27" />
    <!-- Adds an animated splash screen. -->
    <style name="Theme.Shellac.V31" parent="Theme.Shellac.V29" />

    <!-- Base theme -->
    <style name="Theme.Shellac.Base" parent="Theme.Shellac.V31">

        <!-- Material configuration -->
<!--        <item name="colorOutline">@color/overlay_stroke</item>-->
        <item name="motionSpringFastSpatial">@style/Motion.Material3.Spring.Standard.Fast.Spatial</item>
        <item name="motionSpringFastEffects">@style/Motion.Material3.Spring.Standard.Fast.Effects</item>
        <item name="motionSpringDefaultSpatial">
            @style/Motion.Material3.Spring.Standard.Default.Spatial
        </item>
        <item name="motionSpringDefaultEffects">
            @style/Motion.Material3.Spring.Standard.Default.Effects
        </item>
        <item name="motionSpringSlowSpatial">@style/Motion.Material3.Spring.Standard.Slow.Spatial</item>
        <item name="motionSpringSlowEffects">@style/Motion.Material3.Spring.Standard.Slow.Effects</item>
        <item name="appBarLayoutStyle">@style/Widget.Shellac.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.Shellac.Toolbar</item>
        <item name="tabStyle">@style/Widget.Shellac.TabLayout</item>
        <item name="tabSecondaryStyle">@style/Widget.Shellac.TabLayout.Secondary</item>
        <item name="materialButtonStyle">@style/Widget.Shellac.Button</item>
        <item name="materialButtonTonalStyle">@style/Widget.Shellac.Button.TonalButton</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Shellac.Button.OutlinedButton</item>
        <item name="materialButtonElevatedStyle">@style/Widget.Shellac.Button.ElevatedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.Shellac.Button.TextButton</item>
        <item name="snackbarButtonStyle">@style/Widget.Shellac.Button.TextButton.Snackbar</item>
        <item name="materialIconButtonStyle">@style/Widget.Shellac.Button.Icon.Base</item>
        <item name="materialIconButtonOutlinedStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Outlined
        </item>
        <item name="materialIconButtonFilledStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Filled
        </item>
        <item name="materialIconButtonFilledTonalStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Tonal
        </item>
        <item name="materialSplitButtonStyle">@style/Widget.Shellac.SplitButton</item>
        <item name="materialSplitButtonLeadingFilledStyle">
            @style/Widget.Shellac.SplitButton.LeadingButton.Filled
        </item>
        <item name="materialSplitButtonLeadingFilledTonalStyle">
            @style/Widget.Shellac.SplitButton.LeadingButton.Filled.Tonal
        </item>
        <item name="materialSplitButtonIconFilledStyle">
            @style/Widget.Shellac.SplitButton.IconButton.Filled
        </item>
        <item name="materialSplitButtonIconFilledTonalStyle">
            @style/Widget.Shellac.SplitButton.IconButton.Filled.Tonal
        </item>
        <item name="materialAlertDialogTheme">@style/Theme.Shellac.Dialog</item>
        <item name="sliderStyle">@style/Widget.Shellac.Slider</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.Shellac.LinearProgressIndicator</item>
        <item name="bottomSheetStyle">@style/Widget.Shellac.BottomSheet</item>
        <item name="bottomSheetDialogTheme">@style/Widget.Shellac.BottomSheet.Dialog</item>
        <item name="bottomSheetDragHandleStyle">@style/Widget.Shellac.BottomSheet.Handle</item>

        <!-- typography -->
        <!-- some of it is non-standard because the default material typography isnt actually
        using emphasized styles when they are supposed to, and it just looks bad. -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Shellac.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Shellac.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Shellac.DisplaySmall</item>
        <item name="textAppearanceDisplayLargeEmphasized">@style/TextAppearance.Shellac.DisplayLarge.Emphasized</item>
        <item name="textAppearanceDisplayMediumEmphasized">@style/TextAppearance.Shellac.DisplayMedium.Emphasized</item>
        <item name="textAppearanceDisplaySmallEmphasized">@style/TextAppearance.Shellac.DisplaySmall.Emphasized</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Shellac.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Shellac.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Shellac.HeadlineSmall</item>
        <item name="textAppearanceHeadlineLargeEmphasized">@style/TextAppearance.Shellac.HeadlineLarge.Emphasized</item>
        <item name="textAppearanceHeadlineMediumEmphasized">@style/TextAppearance.Shellac.HeadlineMedium.Emphasized</item>
        <item name="textAppearanceHeadlineSmallEmphasized">@style/TextAppearance.Shellac.HeadlineSmall.Emphasized</item>

        <item name="textAppearanceTitleLarge">@style/TextAppearance.Shellac.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Shellac.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Shellac.TitleSmall</item>
        <item name="textAppearanceTitleLargeEmphasized">@style/TextAppearance.Shellac.TitleLarge.Emphasized</item>
        <item name="textAppearanceTitleMediumEmphasized">@style/TextAppearance.Shellac.TitleMedium.Emphasized</item>
        <item name="textAppearanceTitleSmallEmphasized">@style/TextAppearance.Shellac.TitleSmall.Emphasized</item>

        <item name="textAppearanceLabelLarge">@style/TextAppearance.Shellac.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Shellac.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Shellac.LabelSmall</item>
        <item name="textAppearanceLabelLargeEmphasized">@style/TextAppearance.Shellac.LabelLarge.Emphasized</item>
        <item name="textAppearanceLabelMediumEmphasized">@style/TextAppearance.Shellac.LabelMedium.Emphasized</item>
        <item name="textAppearanceLabelSmallEmphasized">@style/TextAppearance.Shellac.LabelSmall.Emphasized</item>

        <item name="textAppearanceBodyLarge">@style/TextAppearance.Shellac.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Shellac.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Shellac.BodySmall</item>
        <item name="textAppearanceBodyLargeEmphasized">@style/TextAppearance.Shellac.BodyLarge.Emphasized</item>
        <item name="textAppearanceBodyMediumEmphasized">@style/TextAppearance.Shellac.BodyMedium.Emphasized</item>
        <item name="textAppearanceBodySmallEmphasized">@style/TextAppearance.Shellac.BodySmall.Emphasized</item>

        <!-- Fix dumb default android behavior -->
        <item name="android:scrollbars">none</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorControlHighlight">@color/sel_compat_ripple</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>

        <!-- Work around hard-coded text highlight colors in the default Material3 theme -->
        <item name="android:textColorHighlight">@color/overlay_text_highlight</item>
        <item name="android:textColorHighlightInverse">@color/overlay_text_highlight_inverse</item>

        <item name="preferenceTheme">@style/PreferenceTheme.Shellac</item>
        <item name="preferenceStyle">@style/Preference.Shellac</item>
        <item name="preferenceCategoryStyle">@style/Preference.Shellac.PreferenceCategory</item>
        <item name="dialogPreferenceStyle">@style/Preference.Shellac.DialogPreference</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.Shellac.SwitchPreferenceCompat
        </item>
        <item name="materialButtonGroupStyle">@style/Widget.Shellac.MaterialButtonGroup</item>
    </style>

    <!-- Make sure blue is the default style instead of material purple -->
    <style name="Theme.Shellac.App" parent="@style/Theme.Shellac.Blue" />

    <!--
    Theming widgets is technically possible below Android 12, but I *really* don't care enough
    to bother with it.
    -->
    <style name="Theme.Shellac.Widget" parent="@style/Theme.Shellac.Blue" />
</resources>
