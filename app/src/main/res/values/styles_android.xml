<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ANDROID COMPONENT-SPECIFIC STYLES.-->

    <style name="Theme.Unruly.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/TextStyle.Unruly.Dialog</item>
        <item name="android:checkedTextViewStyle">@style/Widget.Unruly.Dialog.CheckedTextView</item>
        <item name="materialButtonStyle">@style/Widget.Unruly.Button</item>
        <item name="materialButtonTonalStyle">@style/Widget.Unruly.Button.TonalButton</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Unruly.Button.OutlinedButton</item>
        <item name="materialButtonElevatedStyle">@style/Widget.Unruly.Button.ElevatedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.Unruly.Button.TextButton</item>
        <item name="snackbarButtonStyle">@style/Widget.Unruly.Button.TextButton.Snackbar</item>
        <item name="materialIconButtonStyle">@style/Widget.Unruly.Button.Icon.Base</item>
        <item name="materialIconButtonOutlinedStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Outlined
        </item>
        <item name="materialIconButtonFilledStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Filled
        </item>
        <item name="materialIconButtonFilledTonalStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Tonal
        </item>
        <item name="materialSplitButtonStyle">@style/Widget.Unruly.SplitButton</item>
        <item name="materialSplitButtonLeadingFilledStyle">
            @style/Widget.Unruly.SplitButton.LeadingButton.Filled
        </item>
        <item name="materialSplitButtonLeadingFilledTonalStyle">
            @style/Widget.Unruly.SplitButton.LeadingButton.Filled.Tonal
        </item>
        <item name="materialSplitButtonIconFilledStyle">
            @style/Widget.Unruly.SplitButton.IconButton.Filled
        </item>
        <item name="materialSplitButtonIconFilledTonalStyle">
            @style/Widget.Unruly.SplitButton.IconButton.Filled.Tonal
        </item>
        <item name="buttonBarButtonStyle">@style/Widget.Unruly.Button.TextButton.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Unruly.Button.TextButton.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Unruly.Button.TextButton.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Unruly.Button.TextButton.Dialog.Flush</item>
    </style>

    <style name="TextStyle.Unruly.Dialog" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Unruly.HeadlineSmall.Emphasized</item>
    </style>

    <!-- The style for the checked text view in the custom dialog -->
    <style name="Widget.Unruly.Dialog.CheckedTextView" parent="Widget.Material3.CheckedTextView">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>







    <!-- Widget TextView that mimics the main Unruly Primary/Secondary TextViews. -->
    <style name="Widget.Unruly.TextView.AppWidget" parent="Widget.Unruly.TextView.Base">
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Widget TextView that mimics the main Unruly Primary TextView -->
    <style name="Widget.Unruly.TextView.Primary.AppWidget" parent="Widget.Unruly.TextView.AppWidget">
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleMedium</item>
    </style>

    <!-- Widget TextView that mimics the main Unruly Secondary TextView -->
    <style name="Widget.Unruly.TextView.Secondary.AppWidget" parent="Widget.Unruly.TextView.AppWidget">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyMedium</item>
    </style>

    <!-- A variant of PlaybackButton that plays along with AppWidget restrictions. -->
    <style name="Widget.Unruly.MaterialButton.AppWidget" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">@dimen/size_touchable_small</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- A variant of button that emulates a FAB-ish button that plays along with widget restrictions -->
    <style name="Widget.Unruly.MaterialButton.AppWidget.PlayPause" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minWidth">@dimen/size_touchable_small</item>
        <item name="android:background">@drawable/ui_remote_fab_container_paused</item>
        <item name="android:tint">?attr/colorOnPrimary</item>
    </style>
</resources>
