<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- SHARED RE-USABLE UI STYLES -->

    <style name="Widget.Unruly.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- Fix flickering lift animation when scrolling quickly -->
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Base toolbar style -->
    <style name="Widget.Unruly.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">?attr/textAppearanceTitleLargeEmphasized</item>
        <item name="subtitleTextAppearance">?attr/textAppearanceLabelMediumEmphasized</item>
        <item name="maxButtonHeight">@dimen/size_touchable_small</item>
        <item name="android:paddingLeft">@dimen/spacing_tiny</item>
        <item name="android:paddingStart">@dimen/spacing_tiny</item>
        <item name="android:paddingRight">@dimen/spacing_tiny</item>
        <item name="android:paddingEnd">@dimen/spacing_tiny</item>
    </style>

    <style name="Widget.Unruly.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">?attr/textAppearanceTitleSmallEmphasized</item>
    </style>

    <style name="Widget.Unruly.TabLayout.Secondary" parent="Widget.Material3.TabLayout.Secondary">
        <item name="tabTextAppearance">?attr/textAppearanceTitleSmallEmphasized</item>
    </style>


    <style name="Widget.Unruly.Slider" parent="Widget.Material3.Slider">
        <item name="labelBehavior">gone</item>
        <item name="tickVisible">false</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="trackHeight">@dimen/slider_track_height</item>
        <item name="trackCornerSize">@dimen/slider_track_height</item>
        <item name="trackInsideCornerSize">@dimen/slider_track_height</item>
        <item name="thumbHeight">@dimen/slider_thumb_height</item>
    </style>

    <style name="Widget.Unruly.LinearProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
<!--        <item name="trackColor">@color/sel_track</item>-->
        <item name="trackCornerRadius">@dimen/m3_shape_corners_full</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <style name="Widget.Unruly.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="marginLeftSystemWindowInsets">false</item>
        <item name="marginRightSystemWindowInsets">false</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="paddingTopSystemWindowInsets">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Unruly.BottomSheet</item>
        <item name="shouldRemoveExpandedCorners">true</item>
    </style>

    <style name="ShapeAppearance.Unruly.BottomSheet" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <!-- This is really badly off-spec, but is needed to nicely harmonize the corner radii in the playback bar -->
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.Unruly.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="marginLeftSystemWindowInsets">false</item>
        <item name="marginRightSystemWindowInsets">false</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="paddingTopSystemWindowInsets">false</item>
        <item name="shouldRemoveExpandedCorners">false</item>
    </style>

    <style name="Widget.Unruly.BottomSheet.Dialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Unruly.BottomSheet.Modal</item>
        <item name="materialButtonStyle">@style/Widget.Unruly.Button</item>
        <item name="materialButtonTonalStyle">@style/Widget.Unruly.Button.TonalButton</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Unruly.Button.OutlinedButton</item>
        <item name="materialButtonElevatedStyle">@style/Widget.Unruly.Button.ElevatedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.Unruly.Button.TextButton</item>
        <item name="snackbarButtonStyle">@style/Widget.Unruly.Button.TextButton.Snackbar</item>
        <item name="materialIconButtonStyle">@style/Widget.Unruly.Button.Icon.Base</item>
        <item name="materialIconButtonOutlinedStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Outlined
        </item>
        <item name="materialIconButtonFilledStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Filled
        </item>
        <item name="materialIconButtonFilledTonalStyle">
            @style/Widget.Material3Expressive.Button.IconButton.Tonal
        </item>
        <item name="materialSplitButtonStyle">@style/Widget.Unruly.SplitButton</item>
        <item name="materialSplitButtonLeadingFilledStyle">
            @style/Widget.Unruly.SplitButton.LeadingButton.Filled
        </item>
        <item name="materialSplitButtonLeadingFilledTonalStyle">
            @style/Widget.Unruly.SplitButton.LeadingButton.Filled.Tonal
        </item>
        <item name="materialSplitButtonIconFilledStyle">
            @style/Widget.Unruly.SplitButton.IconButton.Filled
        </item>
        <item name="materialSplitButtonIconFilledTonalStyle">
            @style/Widget.Unruly.SplitButton.IconButton.Filled.Tonal
        </item>
        <item name="android:windowAnimationStyle">@style/Animation.Unruly.BottomSheet.Dialog</item>
    </style>

    <style name="Animation.Unruly.BottomSheet.Dialog" parent="Animation.Material3.BottomSheetDialog">
        <item name="android:windowEnterAnimation">@anim/bottom_sheet_slide_in</item>
        <item name="android:windowExitAnimation">@anim/bottom_sheet_slide_out</item>
    </style>

    <style name="Widget.Unruly.BottomSheet.Handle" parent="Widget.Material3.BottomSheet.DragHandle">
        <item name="android:paddingBottom">0dp</item>
    </style>


















    <!-- TEXTVIEW STYLES -->

    <style name="Widget.Unruly.TextView.Base" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">viewStart</item>
        <item name="emojiCompatEnabled">false</item>
    </style>














    <!-- BUTTON STYLES -->

    <style name="Widget.Unruly.Button" parent="Widget.Material3Expressive.Button">
        <item name="labelTextAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
    </style>

    <style name="Widget.Unruly.Button.TonalButton" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="labelTextAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
    </style>

    <style name="Widget.Unruly.Button.OutlinedButton" parent="Widget.Material3Expressive.Button.OutlinedButton">
        <item name="labelTextAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
    </style>

    <style name="Widget.Unruly.Button.ElevatedButton" parent="Widget.Material3Expressive.Button.ElevatedButton">
        <item name="labelTextAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
    </style>

    <style name="Widget.Unruly.Button.TextButton" parent="Widget.Material3Expressive.Button.TextButton">
        <item name="labelTextAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
    </style>

    <style name="Widget.Unruly.Button.TextButton.Dialog" parent="Widget.Material3Expressive.Button.TextButton.Dialog">
        <item name="labelTextAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
    </style>

    <style name="Widget.Unruly.Button.TextButton.Dialog.Flush" parent="Widget.Material3Expressive.Button.TextButton.Dialog.Flush">
        <item name="labelTextAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
    </style>

    <style name="Widget.Unruly.Button.TextButton.Snackbar" parent="Widget.Material3Expressive.Button.TextButton.Snackbar">
        <item name="labelTextAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
    </style>

    <style name="Widget.Unruly.SplitButton" parent="Widget.Material3.MaterialSplitButton" />

    <style name="Widget.Unruly.SplitButton.LeadingButton.Filled" parent="Widget.Material3.SplitButton.LeadingButton.Filled">
        <item name="labelTextAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
    </style>

    <style name="Widget.Unruly.SplitButton.LeadingButton.Filled.Tonal" parent="Widget.Material3.SplitButton.LeadingButton.Filled.Tonal">
        <item name="labelTextAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
    </style>

    <style name="Widget.Unruly.SplitButton.IconButton.Filled" parent="Widget.Material3.SplitButton.IconButton.Filled" />

    <style name="Widget.Unruly.SplitButton.IconButton.Filled.Tonal" parent="Widget.Material3.SplitButton.IconButton.Filled.Tonal" />



    <style name="Widget.Unruly.Button.Icon.Base" parent="Widget.Material3Expressive.Button.IconButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Unruly.UncheckableIconButton</item>
    </style>

    <style name="ThemeOverlay.Unruly.UncheckableIconButton" parent="">
        <item name="colorContainer">@android:color/transparent</item>
        <item name="colorOnContainer">?attr/colorOnSurfaceVariant</item>
    </style>














</resources>
